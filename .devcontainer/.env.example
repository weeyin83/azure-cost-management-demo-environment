# Normally generated automatically before container creation.
# Copy to .env only to supply your own credentials; never commit the populated file.
# Read the SQL Server container licence before setting ACCEPT_EULA=Y.
ACCEPT_EULA=
# Use a unique, random 20-128 character password, not an example password.
# Supported characters: letters, digits, + / _ = . ! -
MSSQL_SA_PASSWORD=
